@startuml diagrama_clases_dominio
' Diagrama de clases del dominio - TPI Veterinaria G65 (DAO, Tema 2)
' Línea con flecha: navegable en ese sentido. Línea sin flecha: navegable en ambos sentidos.

skinparam shadowing false
skinparam roundCorner 8
skinparam linetype polyline
skinparam nodesep 90
skinparam ranksep 60
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FBE7A1
  BorderColor #3A3A3A
  BorderThickness 1.5
  ArrowColor #3A3A3A
  FontStyle bold
  FontSize 15
  AttributeFontSize 13
  StereotypeFontSize 11
}
hide circle
hide empty methods
hide empty fields

class Usuario {
  -nombre_usuario
  -contrasena
  -rol
}

abstract class Persona {
  -dni
  -nombre
  -apellido
  -telefono
  -email
}

class Cliente {
  -esActivo
}

class Veterinario {
  -matricula
  -especialidad
  -turno_laboral
}

class Bioquimico {
  -matricula
}

class Clinica {
  -id
  -nombre
  -direccion
}

class Mascota {
  -id
  -nombre
  -especie
  -raza
  -fecha_nacimiento
  -peso
  -esActiva
}

class Vacuna {
  -nombre
  -fecha_aplicacion
}

class Turno {
  -numero
  -inicio
  -tipo
  -duracion_minutos
  -motivo
  -cancelado
}

class "Consulta medica" as Consulta {
  -numero
  -fecha_hora
  -tipo_atencion
  -motivo
  -costo
  -diagnostico
  -tratamiento
}

class Comprobante {
  -numero
  -fecha_emision
}

class Orden {
  -numero
  -fecha_hora
  -tipo_estudio
}

class Laboratorio {
  -id
  -nombre
  -direccion
}

class Muestra {
  -codigo
  -fecha_extraccion
  -tipo_muestra
}

class "Estado muestra" as EstadoMuestra <<State>> {
  Extraída
  Empaquetada
  En tránsito
  Recibida
  Analizada
  Rechazada
}

class "Registro trazabilidad" as Trazabilidad {
  -estado
  -fecha_hora
  -motivo
}

class "Resultado analisis" as Resultado {
  -numero
  -fecha
  -informe
}

class Remito {
  -numero
  -fecha_emision
  -transportista
  -fecha_despacho
  -fecha_recepcion
}

class "Estado remito" as EstadoRemito <<State>> {
  En preparación
  En tránsito
  Recibido
  Rechazado
}

class Conservadora {
  -numero
  -capacidad
  -temperatura
}

class Precinto {
  -codigo
  -estaIntacto
  -observaciones
}

class "Evento traslado" as Evento {
  -fecha_hora
  -ubicacion
  -novedad
  -observacion
}

' --- Usuarios ---
' rol: Secretario, Veterinario, Bioquímico o Cliente. El secretario no tiene persona asociada.
Usuario "0..*" --> "0..1" Persona

' --- Herencia ---
Persona <|-- Cliente
Persona <|-- Veterinario
Persona <|-- Bioquimico

' --- Clínica ---
Cliente "1" -- "0..*" Mascota
Mascota "1" --> "0..*" Vacuna
Mascota "1" -- "0..*" Consulta
Clinica "1" -- "1..*" Veterinario
Veterinario "1" -- "0..*" Turno
Turno "0..*" --> "1" Mascota
Turno "0..1" -down- "0..1" Consulta
Veterinario -[hidden]right- Turno
Veterinario "1" -- "0..*" Consulta
Comprobante "0..*" -left-> "1" Consulta

' --- Laboratorio ---
Consulta "1" -- "0..*" Orden
Orden "0..*" --> "1" Laboratorio
Laboratorio "1" -- "1..*" Bioquimico
Orden "1" -- "1..*" Muestra
Muestra "0..*" --> "1" EstadoMuestra
Muestra "1" --> "1..*" Trazabilidad
Muestra "1" --> "0..1" Resultado
Resultado "0..*" -- "1" Bioquimico

' --- Logística ---
Muestra "1..*" -down- "0..1" Remito
Remito "0..*" -down-> "1" EstadoRemito
Remito "0..1" -right- "1" Conservadora
Remito "1" -down-> "1" Precinto
Remito "1" -down-> "0..*" Evento
Remito "0..*" -up-> "1" Clinica
Remito "0..*" -up-> "1" Laboratorio

@enduml
